POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=rag_core_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=rag_audit_log

REDIS_URL=redis://redis:6379/0

QDRANT_HOST=qdrant
QDRANT_PORT=6333

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_PREDICT=512

# Default free tier: Groq hosted models (powerful, no local GPU). If GROQ_API_KEY
# is empty the backend automatically falls back to the local Ollama model.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Tenant bring-your-own-key providers (set per-tenant in the app; these are
# optional platform-wide fallbacks). Stored encrypted when set per-tenant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_API_KEY=local-vllm

# Encrypts tenant BYOK secrets at rest (Fernet key). REQUIRED in production.
FIELD_ENCRYPTION_KEY=
# Base URL of the frontend, used in verification/invite emails.
FRONTEND_URL=http://localhost:3000
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=768
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
BGE_USE_FP16=true
BGE_BATCH_SIZE=12

DJANGO_SECRET_KEY=dev-secret-key-change-in-prod
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,core_api
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000

CORE_API_URL=http://core_api:8000
CORE_API_HOST_HEADER=localhost
RAG_API_URL=http://rag_api:8001

RAG_INTERNAL_INGEST_TOKEN=dev-ingest-token-change-in-prod
SCHEDULER_TRIGGER_TOKEN=dev-scheduler-token-change-in-prod
KEYCLOAK_ISSUER=http://keycloak:8080/realms/rag-saas
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/rag-saas/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=rag-saas
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

UPLOAD_DIR=/tmp/uploads
EMBEDDING_CACHE_TTL_SECONDS=1800
RESPONSE_CACHE_TTL_SECONDS=900

NEXT_PUBLIC_CORE_API_URL=http://localhost:8000
NEXT_PUBLIC_RAG_API_URL=http://localhost:8001

CLOAKED_API_KEYS=true
