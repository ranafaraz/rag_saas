BGE_BATCH_SIZE=12

DJANGO_SECRET_KEY=dev-secret-key-change-in-prod
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,core_api
CORS_ALLOW_ALL_ORIGINS=true
