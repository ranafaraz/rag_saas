CORE_API_URL=http://core_api:8000
CORE_API_HOST_HEADER=localhost
RAG_API_URL=http://rag_api:8001

RAG_INTERNAL_INGEST_TOKEN=dev-ingest-token-change-in-prod
SCHEDULER_TRIGGER_TOKEN=dev-scheduler-token-change-in-prod
