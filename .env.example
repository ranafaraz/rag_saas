OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_PREDICT=512
LLM_PROVIDER=ollama
VLLM_BASE_URL=http://vllm:8000/v1
