KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/rag-saas/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=rag-saas
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

