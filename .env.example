EMBEDDING_CACHE_TTL_SECONDS=1800
RESPONSE_CACHE_TTL_SECONDS=900

NEXT_PUBLIC_CORE_API_URL=http://localhost:8000
NEXT_PUBLIC_RAG_API_URL=http://localhost:8001

CLOAKED_API_KEYS=true
